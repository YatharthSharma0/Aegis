# Aegis backend configuration. Copy to `.env` and adjust for your environment.
# All keys are read by app/config.py (prefix: AEGIS_).

# development | staging | production
AEGIS_ENVIRONMENT=development

# Enable verbose error output. Never true in production.
AEGIS_DEBUG=false

# JSON array or comma-separated list of allowed browser origins.
AEGIS_CORS_ORIGINS=["http://localhost:5173"]
