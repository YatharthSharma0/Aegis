# Aegis backend configuration. Copy to `.env` and adjust for your environment.
# All keys are read by app/config.py (prefix: AEGIS_).

# development | staging | production
AEGIS_ENVIRONMENT=development

# Enable verbose error output. Never true in production.
AEGIS_DEBUG=false

# JSON array or comma-separated list of allowed browser origins.
AEGIS_CORS_ORIGINS=["http://localhost:5173"]

# --- trace engine -----------------------------------------------------------
# Data source for traces. Only "fixture" today; "live" (TronGrid) is Phase 4.5.
AEGIS_PROVIDER_MODE=fixture
# Recorded fixture the trace runs against in fixture mode.
AEGIS_FIXTURE_ID=growjoy_tron_trc20
# Attribution label packs applied to every trace ([] = no attribution).
AEGIS_LABEL_PACKS=["aegis_demo_pack"]

# --- persistence ----------------------------------------------------------
# SQLAlchemy URL. Local default: file SQLite. Compose sets a Postgres URL:
#   postgresql+psycopg://aegis:aegis@db:5432/aegis
AEGIS_DATABASE_URL=sqlite:///./aegis.db
# Log every SQL statement. Never true in production.
AEGIS_DB_ECHO=false

# --- trace worker -------------------------------------------------------
# inline: the API process runs the worker in a thread (dev default).
# external: a separate `python -m app.worker` process (Compose `worker` service).
AEGIS_TRACE_WORKER=inline
AEGIS_WORKER_LEASE_S=120
AEGIS_WORKER_MAX_ATTEMPTS=3
AEGIS_WORKER_POLL_S=1.0

# --- auth ---------------------------------------------------------------
# HMAC key for signing JWTs. Generate a long random value for production
# (e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`).
# The server refuses to start in production with the dev default.
AEGIS_JWT_SECRET=dev-insecure-change-me-not-for-production-use
AEGIS_JWT_ALGORITHM=HS256
AEGIS_ACCESS_TOKEN_TTL_S=900
AEGIS_REFRESH_TOKEN_TTL_S=604800
