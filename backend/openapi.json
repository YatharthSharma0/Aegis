          },
          "confidence_terms": {
            "anyOf": [
              {
                "additionalProperties": {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence Terms"
          },
          "confidence_weights": {
            "anyOf": [
              {
                "additionalProperties": {
                  "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence Weights"
          },
          "deposit_address": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
