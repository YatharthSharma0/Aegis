          },
          "trace_id": {
            "title": "Trace Id",
            "type": "string"
          }
        },
        "required": [
          "trace_id",
          "nodes",
          "edges"
        ],
        "title": "TraceGraphResponse",
        "type": "object"
      },
      "TraceParamsIn": {
        "additionalProperties": false,
        "properties": {
          "max_hops": {
            "default": 8,
            "maximum": 64.0,
            "minimum": 1.0,
            "title": "Max Hops",
            "type": "integer"
          },
          "min_taint": {
            "anyOf": [
              {
                "maximum": 1.0,
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "0.01",
            "title": "Min Taint"
          },
          "min_value": {
            "anyOf": [
              {
                "minimum": 0.0,
                "type": "number"
              },
              {
                "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
                "type": "string"
              }
            ],
            "default": "10",
            "title": "Min Value"
          },
          "taint_model": {
            "$ref": "#/components/schemas/TaintModel",
            "default": "haircut"
          }
        },
        "title": "TraceParamsIn",
        "type": "object"
      },
      "TraceRequest": {
        "additionalProperties": false,
        "properties": {
          "address": {
            "minLength": 1,
