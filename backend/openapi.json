                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Case Id"
          },
          "chain": {
            "$ref": "#/components/schemas/Chain",
            "default": "tron"
          },
          "params": {
            "$ref": "#/components/schemas/TraceParamsIn"
          }
        },
        "required": [
          "address"
        ],
        "title": "TraceRequest",
        "type": "object"
      },
