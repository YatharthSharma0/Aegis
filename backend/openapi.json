        },
        "required": [
          "status",
          "service",
          "version",
          "environment"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LoginRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "minLength": 3,
            "title": "Email",
