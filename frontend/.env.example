# Aegis frontend configuration. Copy to `.env` and adjust.
# Only variables prefixed with VITE_ are exposed to the browser bundle.

# Data source. `demo` (default when unset) serves synthetic sample data in the
# browser with no backend. Set to `live` to use the FastAPI backend.
VITE_DATA_MODE=demo

# Origin for backend API calls, without the /api path. Leave empty in dev: vite proxies `/api`
# to http://localhost:8000 (see vite.config.ts). In production set this to
# the backend origin, e.g. https://aegis.example.gov.in
VITE_API_BASE_URL=
